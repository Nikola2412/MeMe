<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./style/nav.css">
    <link rel="stylesheet" href="./style/main-page.css">
    <link rel="stylesheet" href="./style/scroler.css">
    <link rel="stylesheet" href="./style/video.css">
    <link rel="stylesheet" href="./style/break.css">
    <link rel="stylesheet" href="./style/theme.css">
    <%-include('icons')%>
    <title><%=video.ime + ' Me||Me'%></title>
</head>
<body>
    <div class="fixovanje">
    <header>
        <div class="nav">
                <div class="left">
                    <div class="lines">
                    <div class="line1"></div>
                    <div class="line2"></div>
                    <div class="line3"></div>
                    </div>
                    <a href="/">
                        <img class="logo" src="./images/logo.png" width="100px"height="30px">
                    </a>                
                </div>
                <input class="search" onkeyup="search(this.value)" onfocusout="out(this)" type="text" placeholder="Search..">
                <img class="close" src="./ico/close.png" style="display: none;" width="35" height="35" alt="" srcset="">
                <div class="right">
                    <img class = "lupa" src="./ico/magnifier.png" width="35" height="35" alt="">
                    <img class="nalog" src="./images/profile.png" width="35" height="35" srcset="">
                </div>
            </div>
    </header>
    <div class="container">
        <div class="levi produzen" style="margin-left: 0;">
            <div class="section 1">
                <ul>
                    <li>
                        <a href="/">
                            <button class="vidoes">
                                <img src="./ico/cinema.png" alt="">
                                Vidoes
                            </button>
                        </a>
                    </li>
                    <li>
                        <a href="/newest-memes">
                            <button class="memes">
                                <img src="./ico/short-film.png"  alt="">
                                Memes
                            </button>
                        </a>   
                    </li>
                </ul>
            </div>
            <div class="line"></div>
        </div>
        <div class="desni">
            <%-include('options')%>
            <div class="video">
                <div class="divslike">
                    <video src="/id_videa=<%=video.id%>" controls></video>
                </div>
                <div class="opis">
                    <h3 class="naziv"><%=video.ime%></h3>
                    <div class="opis2">
                        <a href="/chanal?id=<%=video.id_kanala%>&mode=video">
                            <img class="kanal_logo" src="./images/profile.png">
                            <p><%=video.name%></p>
                        </a>
                    </div>
                </div>
            </div>
            <div class="next">
                <%-include('nextvidei')%>
            </div>
        </div>
    </div>
</div>
<div class="scripte">
    <script src="./srcipts/js.js"></script>
    <script src="./srcipts/video.js"></script>
</div>
</body>
</html>