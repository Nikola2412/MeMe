<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./style/nav.css">
    <link rel="stylesheet" href="./style/main-page.css">
    <link rel="stylesheet" href="./style/scroler.css">
    <link rel="stylesheet" href="./style/video.css">
    <link rel="stylesheet" href="./style/break.css">
    <link rel="stylesheet" href="./style/theme.css">
    <%-include('icons')%>
    <title><%=video.ime + ' - Me||Me'%></title>
</head>
<body>
    <div class="fixovanje">
            <%-include('nav')%>
    <div class="container">
        <%-include('leftmeni') %>
        <div class="desni">
            <%-include('options')%>
            <div class="video">
                <div class="levi_video">
                    <div class="divslike">
                        <video id = "current" src="/id_videa=<%=video.id%>" controls></video>
                    </div>
                    <div class="opis">
                        <h3 class="naziv"><%=video.ime%></h3>
                        <div class="opis2">
                            <a href="/chanel?id=<%=video.id_kanala%>&mode=video">
                                <img class="kanal_logo" src="./images/profile.png">
                                <h2><%=video.name%></h2>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="more_from_this">
                    <button class="title">
                        <h3>From this creator</h3>
                        <img class="arrow" src="./ico/up-arrow.png">
                    </button>
                    <div class="videos_from">
                        
                    </div>
                </div>
            </div>
            <div class="next_section">
                <h1>More videos:</h1>
                <div class="next">
                    <%-include('nextvidei')%>
                </div>
            </div>

        </div>
    </div>
</div>
<div class="scripte">
    <script src="./srcipts/js.js"></script>
    <script src="./srcipts/video.js"></script>
</div>
</body>
</html>