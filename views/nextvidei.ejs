        <div class="nextdivslike">
            <a href="/video?id=<%=videi[i].id%>">
                <img src="./thubnails/<%=videi[i].id%>.jpg" alt="">
            </a> 
        </div>
        <div class="nextopis">
            <a href="/chanal?id=<%=videi[i].id_kanala%>&mode=video">
