<% for(var i=0; i < videi.length; i++) { %>
    <div class="nextvideo">
        <div class="nextdivslike">
            <a href="/video<%=videi[i].id%>">
                <img src="./thubnails/<%=videi[i].id%>.jpg" alt="">
                <video src="./videi/<%=videi[i].id%>.mp4" muted disablePictureInPicture></video>
            </a> 
        </div>
        <div class="nextopis">
            <img id="<%=videi[i].id_kanala%>" class="logo" src="./images/profile.png">
            <div class="nextopis2">
                <h3 class="nextnaziv"><%=videi[i].ime%></h3>
                <p><%=videi[i].name%></p>
            </div>
        </div>
    </div>
<% } %>