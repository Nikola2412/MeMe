<% for(var i=0; i < videi.length; i++) { %>
    <div class="video">
        <div class="divslike">
            <a href="/video?id=<%=videi[i].id%>">
                <img src="./thubnails/<%=videi[i].id%>.jpg" alt="">
            </a> 
        </div>
        <div class="opis">
            <a href="/chanal?id=<%=videi[i].id_kanala%>">
                <img class="logo" src="./images/profile.png">
            </a>
            <div class="opis2">
                <h3 class="naziv"><%=videi[i].ime%></h3>
                <p><%=videi[i].name%></p>
            </div>
        </div>
    </div>
<% } %>