<% for(var i=0; i < videi.length; i++) { %>
    <div class="video">
        <div class="divslike">
            <video id="<%=videi[i].id%>" src="./videi/<%=videi[i].id%>.mp4" muted></video>
        </div>
        <div class="opis">
            <img id="<%=videi[i].id_kanala%>" class="logo" src="./images/profile.png">
            <div class="opis2">
                <h3 class="naziv"><%=videi[i].ime%></h3>
                <p><%=videi[i].name%></p>
            </div>
        </div>
    </div>
<% } %>