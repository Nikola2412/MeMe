<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./style/nav.css">
    <link rel="stylesheet" href="./style/main-page.css">
    <link rel="stylesheet" href="./style/scroler.css">
    <link rel="stylesheet" href="./style/user.css">
    <link rel="stylesheet" href="./style/break.css">
    <link rel="stylesheet" href="./style/theme.css">
    <%-include('icons')%>
    <title>Me||Me</title>
</head>
<body>
    <div class="fixovanje">
        <%-include('nav')%>
    <div class="container">
        <div class="levi produzen" style="margin-left: 0;">
            <div class="section 1">
                <ul>
                    <li>
                        <a href="/">
                            <button class="vidoes">
                                <img src="./ico/cinema.png" alt="">
                                Vidoes
                            </button>
                        </a>
                    </li>
                    <li>
                        <a href="/memes">
                            <button class="memes">
                                <img src="./ico/short-film.png"  alt="">
                                Memes
                            </button>
                        </a>   
                    </li>
                </ul>
            </div>
            <div class="line"></div>
        </div>
        <div class="desni">
            <%-include('options')%>
            <div class="centar">
                <div class="info">
                    <img src="./images/profile.png" alt="">
                    <h1><%=data.name%></h1>
                </div>
            </div>
            <div class="meni">
                <button class="vid sada">videos</button>
                <button class="mim">memes</button>
            </div>
            <div class="videos">
                <% for(var i=0; i < videi.length; i++) { %>
                    <div class="video">
                        <div class="divslike">
                            <a href="/video?id=<%=videi[i].id%>">
                                <img src="./thubnails/<%=videi[i].id%>.jpg" alt="">
                            </a>
                        </div>
                        <div class="opis">
                            <h3 class="naziv"><%=videi[i].ime%></h3>
                        </div>
                    </div>
                <% } %>
                <div class="linija" style="height: 1px; background-color: black; width: 100%;"></div>
            </div>
            <div class="memes">
                <!-- da se mimovi preko js ubace -->
            </div>
        </div>
    </div>
</div>
<div class="scripte">
    <script src="./srcipts/js.js"></script>
    <script src="./srcipts/user.js"></script>
</div>
</body>
</html>