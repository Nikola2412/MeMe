<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width,minimum-scale=1">
		<%-include('icons')%>
		<title>Me||Me</title>
        <!-- the form awesome library is used to add icons to our form -->
		<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.1/css/all.css">
        <!-- include the stylesheet file -->
        <link href="./style/register.css" rel="stylesheet" type="text/css">
	</head>
	<body>
		<div class="register">
			<h1>Register</h1>
			<form action="/create" method="post">
				<label for="username">
					<i class="fas fa-user"></i>
				</label>
				<input  type="text" name="username" placeholder="Username" id="username-reg" required>
				<label for="password">
					<i class="fas fa-lock"></i>
				</label>
				<input onkeyup="text1(this.value)" type="password" name="password" placeholder="Password" id="password-reg" required>
                <label for="password">
					<i class="fas fa-lock"></i>
				</label>
				<input onkeyup="text2(this.value)" type="password" name="Password" placeholder="Password" id="password-reg2" required>
				<input type="submit" value="Register" id="submit" disabled>
			</form>
		</div>
	</body>
    <script src="./srcipts/register.js"></script>
</html>